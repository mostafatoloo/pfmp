# Copy to .env — never commit real secrets
# NODE_ENV is managed by Next.js / scripts — do not set here

APP_URL=http://localhost:3000

# SQL Server (Docker Compose default)
DATABASE_URL="sqlserver://localhost:1433;database=pfmp;user=sa;password=Your_strong_Password123;encrypt=true;trustServerCertificate=true"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-32-plus-char-secret
BETTER_AUTH_URL=http://localhost:3000

# Feature flags
AI_ENABLED=false
PASSKEY_ENABLED=true

# Dev-only: English messages with RTL layout simulation (do not enable unfinished locales)
# PFMP_FORCE_RTL=1

# Optional Telegram bot (app works without these)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=

# Optional passkey RP (defaults: localhost / PFMP / BETTER_AUTH_URL)
# PASSKEY_RP_ID=localhost
# PASSKEY_RP_NAME=PFMP

# Negin SMS (OTP codes only — no links). Prefer DotisAcc Acc_System credentials:
# DOTISACC_DATABASE_URL="sqlserver://HOST:2022;database=DotisAcc;user=sa;password=...;encrypt=false;trustServerCertificate=true"
# Or set panel credentials directly:
# NEGIN_USERNAME=
# NEGIN_PASSWORD=
# NEGIN_LINE=


# Integration tests
TEST_DATABASE_URL="sqlserver://localhost:1433;database=pfmp_test;user=sa;password=Your_strong_Password123;encrypt=true;trustServerCertificate=true"

# Worker / export (optional)
# WORKER_POLL_MS=2000
# PFMP_PDF_HTML_ONLY=false
# PFMP_BACKUP_DIR=/var/opt/mssql/backup
